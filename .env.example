# Copy this file to a new file named exactly  .env  and paste ONE key after its = sign (lines starting with # are ignored).
# The .env file is private (it is in .gitignore): never share it or upload it anywhere.

# Open models, free tier (see README): pick one provider
CEREBRAS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Google Gemini (free tier is tiny: ~20 requests/day per model, not enough for a full run)
GEMINI_API_KEY=

